{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdd.local/schema/scripture-reference.v1.json",
  "title": "MDD Scripture Reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["translationId", "startVerseKey", "endVerseKey"],
  "properties": {
    "translationId": {"type": "string", "minLength": 1},
    "startVerseKey": {"type": "string", "pattern": "^[1-3]?[A-Z]{2,3}\\.[1-9][0-9]*\\.[1-9][0-9]*$"},
    "endVerseKey": {"type": "string", "pattern": "^[1-3]?[A-Z]{2,3}\\.[1-9][0-9]*\\.[1-9][0-9]*$"}
  }
}
