{
  "name": "my-daily-devotion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "My Daily Devotion — private, local-first Scripture, reflection, prayer, and devotional history.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:phase0": "node scripts/verify-phase0.mjs",
    "verify:phase1": "npm run verify:phase0 && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
