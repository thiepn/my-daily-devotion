{
  "name": "my-daily-devotion",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "My Daily Devotion — private, local-first Scripture, reflection, prayer, and devotional history.",
  "scripts": {
    "bible:build": "node scripts/build-bsb.mjs",
    "mcheyne:build": "node scripts/build-mcheyne.mjs",
    "notices:build": "node scripts/build-third-party-notices.mjs",
    "dev": "npm run bible:build && npm run mcheyne:build && npm run notices:build && vite",
    "build": "npm run bible:build && npm run mcheyne:build && npm run scripture:verify && npm run notices:build && tsc -b && vite build && node scripts/finalize-sw.mjs",
    "preview:ux": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ux": "playwright test",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "release:package": "npm run build && node scripts/package-release.mjs",
    "verify:phase0": "node scripts/verify-phase0.mjs",
    "verify:phase1": "npm run verify:phase0 && npm run typecheck && npm run test && npm run build",
    "verify:phase2": "npm run verify:phase1 && node scripts/verify-phase2.mjs",
    "verify:phase3": "npm run verify:phase2 && node scripts/verify-phase3.mjs",
    "verify:phase4": "npm run verify:phase3 && node scripts/verify-phase4.mjs",
    "verify:phase5": "npm run verify:phase4 && node scripts/verify-phase5.mjs",
    "verify:phase6": "npm run verify:phase5 && node scripts/verify-phase6.mjs",
    "verify:phase7": "npm run verify:phase6 && node scripts/verify-phase7.mjs",
    "verify:phase8": "npm run verify:phase7 && node scripts/verify-phase8.mjs",
    "verify:phase9": "npm run verify:phase8 && node scripts/verify-phase9.mjs",
    "verify:phase10": "npm run verify:phase9 && node scripts/verify-phase10.mjs",
    "verify:phase11": "npm run verify:phase10 && npm run test:ux && node scripts/verify-phase11.mjs",
    "verify:phase12": "node scripts/certify.mjs",
    "scripture:verify": "node --experimental-strip-types scripts/verify-scripture-content.mjs",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile=verification/unit.json",
    "verify:morning-grace": "npm run verify:morning-grace:phase1 && npm run verify:morning-grace:phase2 && npm run verify:morning-grace:phase3 && npm run verify:morning-grace:phase4 && npm run verify:morning-grace:phase5",
    "verify:morning-grace:phase1": "node scripts/verify-morning-grace-phase1.mjs",
    "verify:morning-grace:phase2": "node scripts/verify-morning-grace-phase2.mjs",
    "verify:morning-grace:phase3": "node scripts/verify-morning-grace-phase3.mjs",
    "verify:morning-grace:phase4": "node scripts/verify-morning-grace-phase4.mjs",
    "verify:morning-grace:phase5": "node scripts/verify-morning-grace-phase5.mjs"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
